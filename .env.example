# ----------------------------------------------------------------------------
# Network Operations Platform — environment configuration (Phase 1)
# Copy this file to `.env` and adjust the values. NEVER commit your real .env.
# ----------------------------------------------------------------------------

# --- General ---
PROJECT_NAME=Network Operations Platform
ENVIRONMENT=development
DEBUG=true

# --- Security (REQUIRED) ---
# Generate a strong key, e.g.:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Bootstrap administrator (created on first startup) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-me-too

# --- CORS (comma-separated origins) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- PostgreSQL ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=netops
POSTGRES_PASSWORD=netops
POSTGRES_DB=netops

# --- Host port mapping (docker-compose) ---
BACKEND_PORT=8000

# ----------------------------------------------------------------------------
# Monitoring (Phase 2)
# ----------------------------------------------------------------------------

# --- SNMP defaults (per-device values override these) ---
SNMP_DEFAULT_COMMUNITY=public
SNMP_DEFAULT_PORT=161
SNMP_TIMEOUT_SECONDS=2.0
SNMP_RETRIES=1

# --- ICMP ping ---
PING_COUNT=3
PING_TIMEOUT_SECONDS=2.0

# --- Zabbix API (optional) ---
# Leave ZABBIX_URL empty to disable Zabbix-based polling. When running the
# bundled Zabbix stack (docker compose --profile monitoring), use:
#   ZABBIX_URL=http://zabbix-web:8080
ZABBIX_URL=
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
ZABBIX_VERIFY_TLS=true
ZABBIX_TIMEOUT_SECONDS=10.0

# --- Bundled Zabbix stack (docker-compose "monitoring" profile) ---
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=zabbix
ZABBIX_DB_NAME=zabbix
ZABBIX_WEB_PORT=8080
ZABBIX_SERVER_PORT=10051

# ----------------------------------------------------------------------------
# Telegram Alert System (Phase 3)
# ----------------------------------------------------------------------------

# --- Bot token (REQUIRED to enable Telegram delivery) ---
# Create a bot with @BotFather and paste its token. Empty = Telegram disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Inbound updates ---
# Set a random secret to enable the webhook at /api/v1/telegram/webhook/<secret>
# (e.g. openssl rand -hex 16). Leave empty and run the poller profile instead.
TELEGRAM_WEBHOOK_SECRET=

# --- Reliability ---
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BACKOFF_SECONDS=0.5
TELEGRAM_TIMEOUT_SECONDS=10.0
TELEGRAM_RATE_LIMIT_PER_SECOND=25
TELEGRAM_PER_CHAT_INTERVAL_SECONDS=1.0
TELEGRAM_POLL_INTERVAL_SECONDS=2.0

# --- Default alert thresholds (used when a rule leaves threshold empty) ---
ALERT_CPU_THRESHOLD=90
ALERT_MEMORY_THRESHOLD=90
ALERT_DISK_THRESHOLD=90
ALERT_INTERFACE_UTIL_THRESHOLD=90
ALERT_PACKET_LOSS_THRESHOLD=20

# ----------------------------------------------------------------------------
# Configuration backup (Phase 4)
# ----------------------------------------------------------------------------
# Fernet key encrypting device SSH secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is derived from SECRET_KEY (dev only — rotating SECRET_KEY
# then makes stored credentials undecryptable).
BACKUP_ENCRYPTION_KEY=
BACKUP_SSH_TIMEOUT_SECONDS=30
